APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_ENV=local
APP_DEBUG=true
# Базовый URL сервиса — используется в Swagger UI (@OA\Server) и абсолютных ссылках
APP_URL=http://localhost:8000

# PostgreSQL: формат postgresql+asyncpg:// совместим с Python-сервисом,
# формат postgresql:// — стандартный.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications

# Redis: номер БД указывается в пути (например /0, /1)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Логика повторных попыток доставки
MAX_RETRIES=3
RETRY_TTL_MS=30000

# TTL ключей идемпотентности в Redis (секунды). По умолчанию 24 часа.
IDEMPOTENCY_TTL=86400

# Лимиты валидации входящих запросов
MAX_RECIPIENTS=1000
MAX_MESSAGE_LENGTH=10000

# Имена очередей и обменников RabbitMQ
MAIN_QUEUE=notifications
RETRY_QUEUE=notifications.retry
DEAD_QUEUE=notifications.dead
DLX_EXCHANGE=notifications.dlx
DEAD_EXCHANGE=notifications.dead.exchange

LOG_CHANNEL=stderr
LOG_LEVEL=debug
